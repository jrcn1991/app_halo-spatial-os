{
  "name": "halo-spatial-os",
  "version": "0.2.1",
  "description": "Halo — Spatial OS. App desktop Linux (Electron) recriando o handoff design_handoff_halo_spatial_os.",
  "homepage": "https://jrcn1991.github.io/halo-spatial-os/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrcn1991/halo-spatial-os.git"
  },
  "bugs": {
    "url": "https://github.com/jrcn1991/halo-spatial-os/issues"
  },
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "author": "Halo",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox --ozone-platform=x11",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview -- --no-sandbox --ozone-platform=x11",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tools",
    "lint:fix": "biome check --write src tools",
    "lint:style": "node tools/style-lint.mjs",
    "check": "npm run typecheck && npm run lint && electron-vite build && npm run lint:style && npm run i18n && npm run test:screens && npm run layout",
    "test:setup": "playwright install chromium",
    "layout": "node tools/layout-check.mjs",
    "test:screens": "node tools/screens-check.mjs",
    "test:live": "node tools/live-check.mjs",
    "dist": "umask 022 && npm run build && chmod -R a+rX build out && electron-builder --linux AppImage deb",
    "island": "node tools/island-check.mjs",
    "doctor": "node tools/doctor.mjs",
    "mascot:extract": "node tools/acs-extract.mjs",
    "vitrine": "node tools/vitrine.mjs",
    "demo-web": "npm run build && node tools/demo-web.mjs",
    "i18n": "node tools/i18n-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "x11": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@fontsource/dm-mono": "^5.2.6",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "xml2js": "^0.6.2",
    "usocket": "^1.1.0"
  }
}
